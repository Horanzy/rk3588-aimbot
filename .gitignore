# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]

# ---- 编译产物 / 模型 / 数据集 (build bin engine dataset 只留在部署机, 不进仓库) ----
build/
bin/
engine/
dataset/
# 模型权重: .axmodel 由仓库外部的转换流程产出后放进 engine/ (转换不在本仓库内)
*.axmodel

# ---- WebUI 运行时状态 (config/profile/历史, 只留在设备上) ----
webui/data/

# ---- arena 诊断输出 (trace CSV/PNG, 可再生) ----
arena/trace_out/

# ---- OS 杂物 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 个人游戏脚本 (含私有标定值, 不进仓库; 仓库只留一份模板) ----
scripts/game/*
!scripts/game/template.sh.example
